  "medical_necessity_criteria": [
    {
      "text": "Aetna considers infrared coagulation medically necessary for the following:"
    },
    {
      "text": "Anal dysplasia;"
    },
    {
      "text": "For members with grade I or grade II internal hemorrhoids that are painful or persistently bleeding. (See Appendix for grading of internal hemorrhoids). Note: Infrared light treatment is considered medically necessary as a heat modality in physical therapy."
    }
