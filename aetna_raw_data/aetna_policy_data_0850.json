{
  "medical_necessity_criteria": [
    {
      "text": "Aetna considers the following interventions medically necessary:"
    },
    {
      "text": "Neuroplasty (neurolysis or nerve decompression) for brachial plexus neuromas and other brachial plexus lesions;"
    },
    {
      "text": "Dorsal root entry zone (DREZ) coagulation for brachial plexus avulsion;"
    },
    {
      "text": "Nerve grafting, nerve transfers and soft tissue reconstruction surgeries (e.g., triangle tilt surgery and the Mod-Quad procedure) for obstetric brachial plexus injury (BPI) (Erb's palsy) if functional recovery does not ensue in 3 or more months. Note : There is a lack of reliable evidence that one type of reconstructive soft tissue technique is more effective than others for obstetric BPIs."
    }
  ],
